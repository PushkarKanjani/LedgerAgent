# =============================================================================
# LedgerAgent — Enterprise Security & Environment Template
# =============================================================================
# Copy this file to .env before starting the production or local service.
# NEVER commit real .env files to source control.
# =============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# JWT Authentication & Cryptography
JWT_SECRET_KEY=ledgeragent_enterprise_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Demo User Password (Seeded for local dev & testing)
DEMO_USER_PASSWORD=LedgerAgent@2026

# External Integrations
MOCK_ERP_URL=http://localhost:8001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cloud Storage & Database (Optional in local-dev mode)
DATABASE_URL=
REDIS_URL=
AWS_REGION=us-east-1
GROQ_API_KEY=
