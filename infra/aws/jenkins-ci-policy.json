{
    "Version":  "2012-10-17",
    "Statement":  [
                      {
                          "Effect":  "Allow",
                          "Sid":  "ECRPushAccess",
                          "Resource":  "*",
                          "Action":  [
                                         "ecr:GetAuthorizationToken",
                                         "ecr:BatchCheckLayerAvailability",
                                         "ecr:GetDownloadUrlForLayer",
                                         "ecr:BatchGetImage",
                                         "ecr:PutImage",
                                         "ecr:InitiateLayerUpload",
                                         "ecr:UploadLayerPart",
                                         "ecr:CompleteLayerUpload",
                                         "ecr:DescribeRepositories",
                                         "ecr:DescribeImages"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "ECSDeploymentAccess",
                          "Resource":  "*",
                          "Action":  [
                                         "ecs:DescribeServices",
                                         "ecs:UpdateService",
                                         "ecs:DescribeTaskDefinition",
                                         "ecs:RegisterTaskDefinition",
                                         "ecs:ListTasks",
                                         "ecs:DescribeTasks"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "PassRoleForECS",
                          "Resource":  "arn:aws:iam::441214867393:role/ledgeragent-*",
                          "Action":  [
                                         "iam:PassRole"
                                     ]
                      },
                      {
                          "Effect":  "Allow",
                          "Sid":  "S3AndSecretsAccess",
                          "Resource":  "*",
                          "Action":  [
                                         "s3:GetObject",
                                         "s3:ListBucket",
                                         "secretsmanager:GetSecretValue",
                                         "secretsmanager:DescribeSecret"
                                     ]
                      }
                  ]
}
