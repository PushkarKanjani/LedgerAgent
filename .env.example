# =============================================================================
# LedgerAgent — Environment Configuration (.env.example)
# Copy to .env and configure secrets before launching Docker Compose
# =============================================================================

# PostgreSQL Database Credentials
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledgerpass2026
POSTGRES_DB=ledgeragent
DATABASE_URL=postgresql://ledger:ledgerpass2026@postgres:5432/ledgeragent

# Redis Checkpointer URL
REDIS_URL=redis://redis:6379/0

# Mock ERP Service URL
MOCK_ERP_URL=http://mock_erp:8001

# JWT Authentication Secret & Algorithm
JWT_SECRET_KEY=ledgeragent_jwt_super_secret_enterprise_key_2026_x
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM Inference (Groq Cloud Llama 3.3 70B)
GROQ_API_KEY=

# AWS Credentials for Textract & S3 (Optional in local-dev fallback mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=ledgeragent-invoices-ap-south-1
